LLM Response: ```sql
-- 产品线扩展机会分析 - 执行业务审查

-- 1. 当前产品组合分析
SELECT 
    `type`,
    COUNT(*) as product_count,
    AVG(COALESCE(`price`, 0)) as avg_price,
    SUM(COALESCE(`opening_stock`, 0)) as total_stock,
    SUM(CASE WHEN `status` = 'active' THEN 1 ELSE 0 END) as active_products
FROM `products` 
WHERE `company_id` = 5
GROUP BY `type`;

-- 2. 高价值产品识别
SELECT 
    `name`,
    `price`,
    `type`,
    `category_id`,
    `track_inventory`,
    `allow_purchase`
FROM `products` 
WHERE `company_id` = 5 
    AND `status` = 'active'
    AND `price` > (SELECT AVG(COALESCE(`price`, 0)) FROM `products` WHERE `company_id` = 5)
ORDER BY `price` DESC;

-- 3. 库存管理分析
SELECT 
    `name`,
    `opening_stock`,
    `track_inventory`,
    `purchase_information`,
    CASE 
        WHEN `opening_stock` <= 10 THEN '低库存'
        WHEN `opening_stock` <= 50 THEN '中等库存'
        ELSE '充足库存'
    END as inventory_level
FROM `products` 
WHERE `company_id` = 5 
    AND `track_inventory` = '1'
ORDER BY `opening_stock` ASC;

-- 4. 产品分类分布
SELECT 
    `category_id`,
    COUNT(*) as product_count,
    AVG(COALESCE(`price`, 0)) as avg_price,
    SUM(COALESCE(`opening_stock`, 0)) as total_stock
FROM `products` 
WHERE `company_id` = 5
GROUP BY `category_id`
ORDER BY product_count DESC;

-- 5. 采购信息分析
SELECT 
    `purchase_information`,
    `allow_purchase`,
    COUNT(*) as product_count,
    AVG(COALESCE(`purchase_price`, 0)) as avg_purchase_price
FROM `products` 
WHERE `company_id` = 5
GROUP BY `purchase_information`, `allow_purchase`;

-- 6. 服务类产品机会
SELECT 
    `name`,
    `price`,
    `sales_description`,
    `description`
FROM `products` 
WHERE `company_id` = 5 
    AND `type` = 'service'
    AND `status` = 'active';

-- 7. 可下载产品分析
SELECT 
    `name`,
    `price`,
    `downloadable`,
    `downloadable_file`
