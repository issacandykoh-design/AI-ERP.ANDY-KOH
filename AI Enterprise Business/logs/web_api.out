-- 需求模式分析：按产品统计销售数量和金额
SELECT 
    `product_id`,
    `name` as `product_name`,
    COUNT(DISTINCT `estimate_template_id`) as `estimate_count`,
    SUM(COALESCE(`quantity`, 0)) as `total_quantity`,
    SUM(COALESCE(`amount`, 0)) as `total_amount`,
    AVG(COALESCE(`unit_price`, 0)) as `avg_unit_price`
FROM `estimate_template_items` 
WHERE `company_id` = 5 AND `type` = 'item'
GROUP BY `product_id`, `name`;

-- 盈利能力细分：按产品分析利润率和销售额
SELECT 
    p.`id` as `product_id`,
    p.`name` as `product_name`,
    p.`price` as `selling_price`,
    p.`purchase_price` as `cost_price`,
    (COALESCE(p.`price`, 0) - COALESCE(p.`purchase_price`, 0)) as `profit_margin`,
    (COALESCE(p.`price`, 0) - COALESCE(p.`purchase_price`, 0)) / NULLIF(p.`price`, 0) * 100 as `profit_margin_percentage`,
    SUM(COALESCE(pi.`amount`, 0)) as `total_sales_amount`
FROM `products` p
LEFT JOIN `estimate_template_items` pi ON p.`id` = pi.`product_id` AND pi.`company_id` = 5
WHERE p.`company_id` = 5
GROUP BY p.`id`, p.`name`, p.`price`, p.`purchase_price`;

-- 竞争差异化评估：分析产品类别和库存状况
SELECT 
    p.`type` as `product_type`,
    p.`status` as `product_status`,
    COUNT(*) as `product_count`,
    AVG(COALESCE(p.`price`, 0)) as `avg_price`,
    SUM(COALESCE(p.`opening_stock`, 0)) as `total_opening_stock`,
    GROUP_CONCAT(DISTINCT p.`hsn_sac_code`) as `hsn_codes`
FROM `products` p
WHERE p.`company_id` = 5
GROUP BY p.`type`, p.`status`;

-- 产品库存调整分析
SELECT 
    p.`name` as `product_name`,
    COUNT(psa.`id`) as `adjustment_count`,
    SUM(COALESCE(psa.`net_quantity`, 0)) as `total_net_quantity`,
    SUM(COALESCE(psa.`quantity_adjustment`, 0)) as `total_quantity_adjustment`,
    AVG(COALESCE(psa.`changed_value`, 0)) as `avg_changed_value`
FROM `products` p
LEFT JOIN `purchase_stock_adjustments` psa ON p.`id` = psa.`product_id` AND psa.`company_id` = 5
WHERE p.`company_id` = 5
GROUP BY p.`id`, p.`name`;

-- 产品在采购和销售中的表现对比
SELECT 
    p.`name` as `product_name`,
    COUNT(DISTINCT eti.`estimate_template_id`) as `sales_occurrences`,
    COUNT(DISTINCT pi.`purchase_order_id`) as `purchase_occurrences`,
    SUM(COALESCE(eti.`quantity`, 0)) as `total_sales_quantity`,
    SUM(COALESCE(pi.`quantity`, 0)) as `total_purchase_quantity`
FROM `products` p
LEFT JOIN `estimate_template_items` eti ON p.`id` = eti.`product_id` AND eti.`company_id` = 5
LEFT JOIN `purchase_items` pi ON p.`id` = pi.`product_id` AND pi.`company_id` = 5
WHERE p.`company_id` = 5
GROUP BY p.`id`, p.`name`;
```
