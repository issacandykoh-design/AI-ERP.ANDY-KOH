-- 业务概览报告
-- 1. 总收入统计
SELECT SUM(COALESCE(`total`, 0)) as total_revenue FROM `invoices` WHERE `company_id` = 5 AND `status` = 'paid';

-- 2. 本月收入
SELECT SUM(COALESCE(`total`, 0)) as monthly_revenue FROM `invoices` WHERE `company_id` = 5 AND `status` = 'paid' AND MONTH(`issue_date`) = MONTH(CURDATE()) AND YEAR(`issue_date`) = YEAR(CURDATE());

-- 3. 活跃客户数量
SELECT COUNT(DISTINCT `client_id`) as active_clients FROM `invoices` WHERE `company_id` = 5 AND `status` = 'paid' AND `issue_date` >= DATE_SUB(CURDATE(), INTERVAL 90 DAY);

-- 4. 本月发票数量
SELECT COUNT(*) as monthly_invoices FROM `invoices` WHERE `company_id` = 5 AND MONTH(`issue_date`) = MONTH(CURDATE()) AND YEAR(`issue_date`) = YEAR(CURDATE());

-- 5. 待处理报价数量
SELECT COUNT(*) as pending_quotations FROM `quotations` WHERE `company_id` = 5;

-- 6. 供应商数量
SELECT COUNT(*) as total_vendors FROM `purchase_vendors` WHERE `company_id` = 5;

-- 7. 项目里程碑完成率
SELECT 
    COUNT(*) as total_milestones,
    SUM(CASE WHEN `status` = 'complete' THEN 1 ELSE 0 END) as completed_milestones,
    ROUND((SUM(CASE WHEN `status` = 'complete' THEN 1 ELSE 0 END) / COUNT(*)) * 100, 2) as completion_rate
FROM `project_milestones` WHERE `company_id` = 5;

-- 8. 订阅状态
SELECT `subscription_status`, COUNT(*) as count FROM `global_subscriptions` WHERE `company_id` = 5 GROUP BY `subscription_status`;
