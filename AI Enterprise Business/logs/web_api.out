-- 获取公司财务状况概览
SELECT 
    (SELECT COALESCE(SUM(`total`), 0) FROM `quotations` WHERE `company_id` = 5) as total_quotations,
    (SELECT COALESCE(SUM(`estimated_budget`), 0) FROM `estimate_requests` WHERE `company_id` = 5 AND `status` = 'accepted') as accepted_estimates,
    (SELECT COUNT(*) FROM `purchase_vendors` WHERE `company_id` = 5) as total_vendors,
    (SELECT COUNT(*) FROM `objectives` WHERE `company_id` = 5) as active_objectives;

-- 分析供应商质量
SELECT 
    `category_id`,
    COUNT(*) as vendor_count,
    AVG(COALESCE(`opening_balance`, 0)) as avg_opening_balance
FROM `purchase_vendors` 
WHERE `company_id` = 5 
GROUP BY `category_id`;

-- 评估项目目标完成情况
SELECT 
    `priority`,
    `check_in_frequency`,
    COUNT(*) as objective_count,
    AVG(DATEDIFF(`end_date`, `start_date`)) as avg_duration_days
FROM `objectives` 
WHERE `company_id` = 5 
GROUP BY `priority`, `check_in_frequency`;

-- 分析库存管理效率
SELECT 
    AVG(COALESCE(`changed_value`, 0)) as avg_inventory_change,
    AVG(COALESCE(`adjusted_value`, 0)) as avg_adjustment_value,
    COUNT(*) as total_adjustments
FROM `purchase_inventory_histories` 
WHERE `company_id` = 5;
```
