<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\Artisan;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

class SetupVerify extends Command
{
    protected  = 'app:setup-verify {--clear} {--fix-cache}';
    protected  = 'Verify application setup and environment';

    public function handle()
    {
         = [];

        [] = ['name' => 'Environment', 'status' => app()->environment(), 'ok' => app()->environment() !== 'local'];

         = true;
        try {
            DB::connection()->getPdo();
        } catch (\Throwable ) {
             = false;
            ->error(->getMessage());
        }
        [] = ['name' => 'Database', 'status' =>  ? 'connected' : 'fail', 'ok' => ];

         = is_writable(storage_path()) && is_writable(storage_path('logs')) && is_writable(base_path('bootstrap/cache'));
        [] = ['name' => 'StorageWritable', 'status' =>  ? 'ok' : 'fail', 'ok' => ];

         = class_exists(\App\Actions\Fortify\RedirectIfTwoFactorConfirmed::class);
        [] = ['name' => 'FortifyRedirectClass', 'status' =>  ? 'exists' : 'missing', 'ok' => ];

         = resource_path('views/components/forms/input-group.blade.php');
         = is_file() && Str::contains((string) file_get_contents(), '@props');
        [] = ['name' => 'InputGroupProps', 'status' =>  ? 'ok' : 'missing', 'ok' => ];

         = false;
         = base_path('composer.json');
        if (is_file()) {
             = json_decode((string) file_get_contents(), true);
             = data_get(, 'scripts.post-update-cmd', []);
            foreach ( as ) {
                if (is_string() && Str::contains(, 'migrate')) {
                     = true;
                    break;
                }
            }
        }
        if () {
            ->warn('Composer post-update triggers migrations; disable for safer deploys');
        }

        foreach ( as ) {
            ->line((['ok'] ? '[OK] ' : '[FAIL] ').['name'].' = '.['status']);
        }

        if (->option('clear')) {
            Artisan::call('optimize:clear');
            ->line('[DONE] optimize:clear');
        }

        if (->option('fix-cache')) {
            Artisan::call('config:cache');
            Artisan::call('route:cache');
            // Skip view cache intentionally if missing components could break
            ->line('[DONE] config/route cache rebuilt');
        }

        return 0;
    }
}
